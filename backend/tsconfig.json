{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "allowSyntheticDefaultImports": true
  },
  "include": ["/**/*", "config", "controllers", "middleware", "models", "routes", "scripts", "types", "utils", "server.ts"],
  "exclude": ["node_modules", "dist"]
}

