{
  "name": "hrms-backend",
  "version": "1.0.0",
  "description": "HRMS Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:employees": "ts-node-dev --transpile-only scripts/migrateEmployees.ts",
    "check:payroll": "ts-node --transpile-only scripts/payroll-module-check.ts",
    "seed:payroll-sample": "ts-node --transpile-only scripts/runSeedPayrollSample.ts",
    "test": "vitest run"
  },
  "vitest": {
    "environment": "node",
    "include": [
      "tests/**/*.test.ts"
    ],
    "passWithNoTests": true
  },
  "keywords": [
    "hrms",
    "hr",
    "management"
  ],
  "author": "Aditya",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.6.0",
    "googleapis": "^171.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
